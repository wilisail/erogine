# Server-only. Use the Erogine runtime role, never the TemuEvent owner credentials.
DATABASE_URL=
# Generate a separate random 32-byte hexadecimal value for each environment.
AUTH_JWT_SECRET=
APP_URL=http://localhost:3000
# PayPal Developer dashboard > Apps & Credentials > Sandbox.
# Keep the secret server-only. The client ID is public by PayPal's design.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# OpenRouter only; optional until Block 4 setup. No paid fallback is accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
